# Copy this file to .env and fill in your eBay Production keyset
# from https://developer.ebay.com -> Your Account -> Application Keysets.
# .env is gitignored — never commit real credentials.

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Production by default; switch to https://api.sandbox.ebay.com for sandbox
EBAY_BASE_URL=https://api.ebay.com

# Optional: which marketplace to search
EBAY_MARKETPLACE=EBAY_US
